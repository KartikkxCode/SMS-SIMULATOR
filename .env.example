# Copy this file to .env and fill in your values. Never commit .env.

# MSG91 auth key: MSG91 dashboard → Authkey. Leave empty to use Simulate mode only.
MSG91_AUTH_KEY=

# Default template ID (the MSG91 SMS template linked to your DLT template and sender ID).
# You can also type a different one in the app.
MSG91_TEMPLATE_ID=

# Country code added to numbers written without one (91 = India).
DEFAULT_COUNTRY_CODE=91

# Numbers sent per MSG91 request, and the pause between requests (milliseconds).
BATCH_SIZE=100
BATCH_DELAY_MS=500

# Where the app runs. Keep HOST=127.0.0.1 so only your computer can reach it.
PORT=3000
HOST=127.0.0.1

# Where the WhatsApp send log and opt-out list are kept.
DATA_DIR=data

# ---------------------------------------------------------------------------
# WhatsApp through Meta's Cloud API (see README → WhatsApp → Option A)
# ---------------------------------------------------------------------------
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_WABA_ID=
WHATSAPP_META_API_VERSION=v26.0
# Needed for delivery receipts, or if "Require app secret" is on in your Meta app.
WHATSAPP_META_APP_SECRET=
# Where marketing templates go: auto, messages or marketing_messages.
WHATSAPP_MARKETING_ENDPOINT=auto

# ---------------------------------------------------------------------------
# WhatsApp through MSG91 (uses MSG91_AUTH_KEY above; see README → Option B)
# ---------------------------------------------------------------------------
# Your WhatsApp number integrated in MSG91, digits only, e.g. 919000000001
MSG91_WHATSAPP_NUMBER=
WHATSAPP_MSG91_CHUNK=100

# ---------------------------------------------------------------------------
# WhatsApp sending limits
# ---------------------------------------------------------------------------
# Messages per second through Meta (Meta allows about 80).
WHATSAPP_RATE_PER_SEC=20
# New contacts per 24 hours (your WhatsApp messaging limit); 0 = no limit.
WHATSAPP_DAILY_LIMIT=250
# Your price per WhatsApp message in rupees, for the cost estimate (e.g. 0.86).
WHATSAPP_PRICE_PER_MESSAGE=

# ---------------------------------------------------------------------------
# Optional: WhatsApp delivery receipts through a public tunnel (README → Delivery receipts)
# ---------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PUBLIC_WEBHOOK_HOST=
